# Mailbox Manager: one .env file at the repo root, read by Next.js, the Prisma CLI, the worker,
# the seed and the tests. Copy it with `cp .env.example .env`. Never create .env.local.
#
# Passwords with special characters must be URL-encoded inside connection strings
# (for example @ becomes %40, # becomes %23).

# development | test | production
NODE_ENV=development

# Development database. Default: the docker-compose Postgres on host port 5433.
DATABASE_URL=postgresql://mailbox_manager:mailbox_manager@localhost:5433/mailbox_manager_dev
# Local server variant (after scripts/db/setup-local.sh):
# DATABASE_URL=postgresql://mailbox_manager:mailbox_manager@localhost:5432/mailbox_manager_dev

# Integration tests only. The database name MUST end with _test; tests refuse anything else.
TEST_DATABASE_URL=postgresql://mailbox_manager:mailbox_manager@localhost:5433/mailbox_manager_test
# TEST_DATABASE_URL=postgresql://mailbox_manager:mailbox_manager@localhost:5432/mailbox_manager_test

# HS256 key for session tokens, at least 32 characters. DEVELOPMENT PLACEHOLDER: works locally,
# refused when NODE_ENV=production. Generate a real one with: openssl rand -base64 48
SESSION_SECRET=dev-only-insecure-session-secret-change-me-0123456789

# Session cookie and token lifetime in hours.
SESSION_TTL_HOURS=8

# Show the seeded demo logins on /login (true or false).
SHOW_DEMO_CREDENTIALS=true

# debug | info | warn | error (debug also logs SQL queries).
LOG_LEVEL=info

# Worker: sleep between polls when no order is pending.
WORKER_POLL_INTERVAL_MS=1000
# Worker: lease renewal interval while provisioning an order.
WORKER_HEARTBEAT_INTERVAL_MS=5000
# Worker: a PROVISIONING order whose lease is older than this is failed by the sweeper.
# Must be greater than 3 x WORKER_HEARTBEAT_INTERVAL_MS.
WORKER_LEASE_TIMEOUT_MS=60000
# Worker: how long shutdown waits for the in-flight order.
WORKER_SHUTDOWN_GRACE_MS=30000

# Mailboxes provisioned in parallel per order (1 to 10).
PROVIDER_CONCURRENCY=5
# Timeout for one provider call.
PROVIDER_CALL_TIMEOUT_MS=10000

# Mock provider latency bounds (min must not exceed max).
MOCK_PROVIDER_MIN_DELAY_MS=1000
MOCK_PROVIDER_MAX_DELAY_MS=3000
# Probability that one mailbox call fails (0 to 1).
MOCK_PROVIDER_FAILURE_RATE=0.2
